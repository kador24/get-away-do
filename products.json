  "faq": [
    {
      "q": "هل الهواتف المستعملة مضمونة؟",
      "a": "نعم، كل جهاز يخضع لفحص شامل (شاشة، بطارية، شبكة، منافذ) ويُباع مع ضمان استبدال 7 أيام في حال وجود عيب مخفي."
    },
    {
      "q": "ما معنى تقييم الحالة من 10؟",
      "a": "تقييم نمنحه لكل جهاز بعد الفحص: 9/10 يعني حالة شبه جديدة، 8/10 خدوش خفيفة جداً، 7/10 آثار استعمال واضحة. التقييم دقيق وشفاف."
    },
    {
      "q": "هل يمكن الطلب من خارج مدينة مسعد؟",
      "a": "حالياً نستقبل الطلبات من مسعد والمناطق المجاورة عبر واتساب، مع إمكانية التوصيل حسب الاتفاق. التوصيل مجاني للطلبات فوق 5000 دج."
    },
    {
      "q": "هل القطع الغيار أصلية؟",
      "a": "نوفر قطعاً أصلية وقطعاً من الدرجة الأولى (كوبي درجة أولى). النوع مذكور بوضوح في وصف كل منتج، وكل قطعة تُركب بضمان."
    },
    {
      "q": "كم تستغرق عملية التصليح؟",
      "a": "أغلب الأعطال (شاشة، بطارية، منفذ شحن) تُنجز في نفس اليوم وغالباً خلال ساعة. الأعطال المعقدة قد تحتاج 2-3 أيام."
    }
  ]
